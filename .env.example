# Never commit a real key. The demo script uses Anvil's public development keys on its own.

# Deployer. On Arc this address also signs price attestations.
PRIVATE_KEY=

# Three agent keys, comma-separated, for packages/agents live mode.
# They must be different from the deployer. ScoreAnchor cannot own the agent NFT.
AGENT_KEYS=

# 10143 Monad testnet, 143 Monad mainnet, 5042 Arc, 31337 local Anvil
CALLBOOK_CHAIN_ID=10143
CALLBOOK_RPC_URL=https://testnet-rpc.monad.xyz

# Optional path to deployments/<chainId>.json
# CALLBOOK_DEPLOYMENT=

# Commit window. Reveal must happen within REVEAL_WINDOW seconds.
# The horizon passed by the agents must be longer than REVEAL_WINDOW.
REVEAL_WINDOW=120
PIN_WINDOW=3600
MAX_STALENESS=3600
MIN_SAMPLES=1
MIN_WIN_BPS=5000

# Live agents
CALLBOOK_ASSET=ETH-USD
HORIZON_SEC=300

# Clerk. Leave blank to use the deterministic mock.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Web dashboard. Point these at the chain you deployed.
# CALLBOOK_CHAIN_ID=31337
# CALLBOOK_RPC_URL=http://127.0.0.1:8545
